# ===========================================
# Stash — Environment Configuration
# ===========================================
# Copy this file to .env and update values.
# LOCAL DEV: use defaults below as-is.
# UNRAID PROD: update DATA_PATH, passwords,
#   and API keys before deploying.
# ===========================================

NODE_ENV=development

# Ports
BACKEND_PORT=3001
ADMIN_PORT=3002

# Data storage path
# Local dev: ./data
# Unraid prod: /mnt/user/appdata/stash
DATA_PATH=./data

# PostgreSQL
DATABASE_URL=postgresql://stash:stash@stash-postgres:5432/stash
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Anthropic Claude API (for price estimates)
ANTHROPIC_API_KEY=your_key_here

# Backend URL (used by admin/mobile to reach the API)
BACKEND_URL=http://localhost:3001

# Unraid conventions (prod only)
PUID=99
PGID=100
TZ=America/Denver
