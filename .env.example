# ===========================================
# Stash — Environment Configuration
# ===========================================
# Copy this file to .env and update values.
# LOCAL DEV: defaults below work as-is.
# UNRAID PROD: see comments on each var. The split between DATA_PATH and
#   POSTGRES_DATA_PATH is critical — see SETUP.md "Section 2".
# ===========================================

NODE_ENV=development

# Ports
BACKEND_PORT=3001
ADMIN_PORT=3002

# ── Storage paths (read carefully on Unraid) ─────────────────────────
# DATA_PATH holds uploaded files (photos, QR codes, exports, floorplans).
# These are not DB-heavy, so the FUSE union path /mnt/user/ is fine and
# gives you parity protection across the array.
#
# POSTGRES_DATA_PATH holds the live Postgres data files. Postgres is
# extremely sensitive to I/O latency, and Unraid's FUSE/shfs layer adds
# catastrophic overhead for database containers. ALWAYS pin Postgres data
# to direct NVMe via /mnt/cache/ — never /mnt/user/. (Reference:
# D:/James_Journey/areas/homelab/container-setup-details.md.)
#
# Local dev defaults — both inside ./data/, no FUSE involved.
# Unraid prod values:
#   DATA_PATH=/mnt/user/appdata/stash
#   POSTGRES_DATA_PATH=/mnt/cache/appdata/stash/postgres
DATA_PATH=./data
POSTGRES_DATA_PATH=./data/postgres

# PostgreSQL
DATABASE_URL=postgresql://stash:stash@stash-postgres:5432/stash
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Anthropic Claude API (for price estimates — optional)
# Without this, /api/pricing/* returns 503; everything else still works.
ANTHROPIC_API_KEY=

# Backend URL (used by admin/mobile to reach the API)
BACKEND_URL=http://localhost:3001

# Seed passwords — read by `prisma db seed` to set initial passwords for
# the admin and the regular user. If unset, the seed uses a placeholder
# and prints a warning telling you to change it via the Users page.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Unraid conventions (prod only)
PUID=99
PGID=100
TZ=America/Denver
