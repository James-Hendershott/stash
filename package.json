{
  "name": "stash",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted inventory and move management application",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/admin",
    "packages/mobile"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w packages/backend",
    "dev:admin": "npm run dev -w packages/admin",
    "build:shared": "npm run build -w packages/shared",
    "build:backend": "npm run build -w packages/backend",
    "build:admin": "npm run build -w packages/admin",
    "build": "npm run build:shared && npm run build:backend && npm run build:admin",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "db:seed": "npm run db:seed -w packages/backend",
    "db:studio": "npm run db:studio -w packages/backend"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
