{
  "expo": {
    "name": "Stash",
    "slug": "stash",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shottsserver.stash"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8fafc"
      },
      "package": "com.shottsserver.stash"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
